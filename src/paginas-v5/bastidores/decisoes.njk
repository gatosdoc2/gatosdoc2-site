  <section class="section"><div class="wrap"><section class="tabela-rolagem" aria-label="Decisões" tabindex="0"><table class="tabela"><thead><tr><th>Nº</th><th>Decisão</th><th>Situação</th></tr></thead><tbody><tr><td>0001</td><td>Static site</td><td>Accepted</td></tr><tr><td>0002</td><td>`AGENTS.md` as single source of AI instructions</td><td>Accepted</td></tr><tr><td>0003</td><td>Phased work with gates; AI neither approves nor publishes</td><td>Accepted</td></tr><tr><td>0004</td><td>English for docs and code, Portuguese for site content</td><td>Accepted</td></tr><tr><td>0005</td><td>Token-efficient workflow: text-output verification, no routine screenshots</td><td>Accepted</td></tr><tr><td>0006</td><td>project lead approves all gates</td><td>Accepted</td></tr><tr><td>0007</td><td>Questions never block; ship basic, iterate</td><td>Accepted</td></tr><tr><td>0008</td><td>Public GitHub repository from now | Superseded by 0012 |</td><td>0009</td></tr><tr><td>0010</td><td>What the site may claim (numbers, TNR, law, wildlife)</td><td>Accepted</td></tr><tr><td>0011</td><td>AI design tooling: `frontend-design` as reviewer, Impeccable `detect` only, no Hallmark</td><td>Accepted</td></tr><tr><td>0012</td><td>Two repositories: private planning repo, clean public site repo</td><td>Accepted</td></tr><tr><td>0013</td><td>Site stack: Eleventy 3.1.8 on Node 26, Markdown pages, no client JavaScript</td><td>Accepted</td></tr><tr><td>0014</td><td>Sitemap, launch scope and the &quot;em construção&quot; pattern</td><td>Accepted</td></tr><tr><td>0015</td><td>Web visual identity &quot;Caderno de campo&quot; and code-first design</td><td>Accepted</td></tr><tr><td>0016</td><td>Voice and tone for the Portuguese copy</td><td>Accepted</td></tr><tr><td>0017</td><td>No forms and no analytics in the first version</td><td>Accepted</td></tr><tr><td>0018</td><td>Secrets handling and publishing flow</td><td>Accepted</td></tr><tr><td>0019</td><td>AI tooling adopted, with pinned versions</td><td>Accepted</td></tr><tr><td>0020</td><td>Automated check suite: tools and thresholds</td><td>Accepted</td></tr><tr><td>0021</td><td>Contents of the clean site repository</td><td>Accepted</td></tr><tr><td>0022</td><td>Impeccable dropped (engine binary)</td><td>Accepted</td></tr><tr><td>0023</td><td>Python for design-time scripts, planning repo only</td><td>Accepted</td></tr><tr><td>0024</td><td>Page copy as Markdown in `content/`, checked by `check-content.py`</td><td>Accepted</td></tr><tr><td>0025</td><td>Build adjustments to the check suite and page pipeline</td><td>Proposed</td></tr><tr><td>0026</td><td>Visual revision: colony cards, photos on every page, CSS motion</td><td>Accepted</td></tr><tr><td>0027</td><td>Unlisted &quot;bastidores&quot; pages: assets, identity, design decisions</td><td>Accepted</td></tr><tr><td>0028</td><td>Fictitious and placeholder content allowed in prototypes, never published</td><td>Accepted</td></tr><tr><td>0029</td><td>English version of selected pages</td><td>Proposed</td></tr><tr><td>0030</td><td>Live tiles (looping faces) with a pause control</td><td>Proposed</td></tr><tr><td>0031</td><td>&quot;Lojinha&quot;: a catalog page, orders through the group&#x27;s channels</td><td>Proposed</td></tr><tr><td>0032</td><td>Top navigation with six items and an &quot;O que fazemos&quot; hub</td><td>Proposed</td></tr><tr><td>0033</td><td>Build: the site is ported from prototype v5 by a script</td><td>Proposed</td></tr><tr><td>0034</td><td>First version publishes examples, the shop and the prototype panel</td><td>Accepted</td></tr><tr><td>0035</td><td>One small decorative script: cat eyes follow the pointer and blink</td><td>Proposed</td></tr></tbody></table></section>
