{#- Prototype options panel (review tool, published in v1 by decision 0034; EXEMPLOS=0 hides it). -#}
{% if exemplos %}
<details class="opcoes" data-sem-copia>
  <summary><svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"></path></svg> Protótipo</summary>
  <div class="opcoes__corpo">
    <nav aria-label="Páginas de apoio"><p class="opcoes__titulo">Páginas de apoio</p><ul class="opcoes__links"><li><a href="/bastidores/opcoes/">O que é cada opção</a></li><li><a href="/bastidores/">Identidade visual</a></li><li><a href="/bastidores/decisoes/">Decisões</a></li><li><a href="/404.html">Página 404</a></li><li><a href="/en/">Versão em inglês</a></li></ul></nav>
    {% if page.url == "/" %}<fieldset><legend>Início</legend><label><input type="radio" name="op-hero" id="op-hero-b" checked> B: bloco grande com fotos</label><label><input type="radio" name="op-hero" id="op-hero-a"> A: texto + mosaico</label></fieldset><fieldset><legend>Só nesta página</legend><label><input type="checkbox" id="op-cursor" checked> Cursor de patinha nos gatos</label><label><input type="checkbox" id="op-dormindo" checked> Gato dormindo (mosaico)</label><label><input type="checkbox" id="op-caixa" checked> Gato na caixa (bichanos)</label><label><input type="checkbox" id="op-estica" checked> Gato espreguiçando (bichanos)</label><label><input type="checkbox" id="op-coracao" checked> Patinhas e coração em "Quero adotar"</label><label><input type="checkbox" id="op-olhar" checked> Gato que olha o canal (contato)</label></fieldset>{% elif page.url == "/404.html" %}<fieldset><legend>Só nesta página</legend><label><input type="checkbox" id="op-404" checked> Gato brincando com o novelo</label></fieldset>{% elif page.url == "/noticias/" %}<fieldset><legend>Só nesta página</legend><label><input type="checkbox" id="op-selo" checked> Selo de patinha no destaque</label></fieldset>{% endif %}<fieldset><legend>Movimento</legend><label><input type="checkbox" id="pausar-animacoes"> Pausar animações</label></fieldset>
    <fieldset><legend>Barra superior</legend><label><input type="radio" name="op-header" id="op-header-escuro" checked> Escura</label><label><input type="radio" name="op-header" id="op-header-claro"> Clara</label></fieldset>
    <fieldset><legend>Em todas as páginas</legend><label><input type="checkbox" id="op-patas" checked> Patinhas (lateral esquerda)</label><label><input type="checkbox" id="op-novelo" checked> Novelo desenrolando</label><label><input type="checkbox" id="op-espiao" checked> Gato espiando no rodapé</label><label><input type="checkbox" id="op-topo" checked> Gato do "Voltar ao topo"</label><label><input type="checkbox" id="op-silhueta"> Gato atravessando o rodapé</label></fieldset>
  </div>
</details>
{% endif %}
